#!/usr/bin/env bash
# Displays DNS record information for a domain and its subdomains.

display_subdomain() {
    local domain="$1"
    local subdomain="$2"
    local result
    local record_type
    local destination

    result=$(dig "$subdomain.$domain" | awk '/ANSWER SECTION:/ {getline; print $4, $5}')

    read -r record_type destination <<< "$result"

    echo "The subdomain $subdomain is a $record_type record and points to $destination"
}

if [ "$#" -eq 2 ]; then
    display_subdomain "$1" "$2"
else
    display_subdomain "$1" "www"
    display_subdomain "$1" "lb-01"
    display_subdomain "$1" "web-01"
    display_subdomain "$1" "web-02"
fi
